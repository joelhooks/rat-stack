{
  "name": "rat-stack",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic TypeScript scaffold: Effect 4, XState 6 with @xstate/effect, Alchemy infra, varlock config, and a lint/typecheck fence that makes cheating uncomfortable.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @rat-stack/web dev",
    "acceptance:cold-clone": "bash scripts/acceptance-cold-clone.sh",
    "alchemy": "pnpm --filter @rat-stack/infra exec alchemy",
    "build": "turbo run build",
    "check": "pnpm run lockfile:check && varlock load && turbo run typecheck && ultracite check && oxfmt --check .",
    "cli": "turbo run build --filter=@rat-stack/cli && node apps/cli/dist/cli.js",
    "env:check": "varlock load",
    "fix": "ultracite fix && oxfmt .",
    "lint": "ultracite check && oxfmt --check .",
    "lockfile:check": "pnpm --config.optimistic-repeat-install=false install --frozen-lockfile --offline --lockfile-only --ignore-scripts",
    "mischief:smoke": "pnpm site:smoke",
    "site:smoke": "bash apps/site/scripts/smoke.sh",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "deploy:plan": "pnpm turbo run build --concurrency=1 && APP_ENV=production pnpm exec varlock run -- sh -c 'cd apps/infra && exec node --import ./node_modules/alchemy/bin/register-oxc.js ../../packages/deploy/dist/cli.js \"$@\"' deploy deployPlan",
    "deploy:prod": "pnpm turbo run build --concurrency=1 && APP_ENV=production pnpm exec varlock run -- sh -c 'cd apps/infra && exec node --import ./node_modules/alchemy/bin/register-oxc.js ../../packages/deploy/dist/cli.js \"$@\"' deploy deployProd",
    "deploy:preview": "bash scripts/deploy-preview.sh deploy",
    "deploy:preview:destroy": "bash scripts/deploy-preview.sh destroy",
    "deploy:rollback": "pnpm turbo run build --concurrency=1 && APP_ENV=production pnpm exec varlock run -- sh -c 'cd apps/infra && exec node --import ./node_modules/alchemy/bin/register-oxc.js ../../packages/deploy/dist/cli.js \"$@\"' deploy deployRollback",
    "infra:deploy": "pnpm --filter @rat-stack/infra deploy",
    "infra:destroy": "pnpm --filter @rat-stack/infra destroy",
    "infra:dev": "pnpm --filter @rat-stack/infra dev",
    "infra:plan": "pnpm --filter @rat-stack/infra plan",
    "prepare": "effect-tsgo patch && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "git-snapshot": "node apps/site/scripts/generate-content.ts --git-snapshot && oxfmt .brain/data/git-snapshot.json",
    "sources:fetch": "node apps/site/scripts/fetch-code-sources.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:fast": "turbo run typecheck:fast typecheck:fast-scripts",
    "typecheck:fast-scripts": "tsrs --noEmit -p tsconfig.json",
    "typecheck:parity": "pnpm --filter @rat-stack/core typecheck:parity",
    "typecheck-scripts": "tsc --noEmit -p tsconfig.json",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh",
    "cafe:import": "node scripts/cafe-import.ts",
    "content:migrate": "node apps/site/scripts/migrate-content.ts",
    "find-peers": "node scripts/find-peers.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@effect/tsgo": "0.55.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "24.19.2",
    "effect": "4.0.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "portless": "0.15.8",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "2.11.9",
    "typescript": "7.0.2",
    "ultracite": "8.0.1",
    "varlock": "1.23.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24.18.0",
    "pnpm": ">=11.1.2"
  },
  "packageManager": "pnpm@11.3.0"
}
