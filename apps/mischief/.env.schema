# Optional deployment controls for the off-by-default Web Bot Auth directory.
# Alchemy binds yielded Config values into the Worker; Redacted values become
# Cloudflare secret_text bindings and never belong in this file.
#
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Keep false unless the auth.md route fails the live Level 5 scan.
# @type=boolean
# @sensitive=false
WEB_BOT_AUTH_ENABLED=false

# An Ed25519 private JWK. The Worker publishes only its public fields.
WEB_BOT_AUTH_PRIVATE_JWK=

# Request analytics. Off declares only the events bucket, stream, and salt and leaves requests unrecorded. On also declares the R2 Data Catalog, Iceberg sink, and pipeline, and needs EVENTS_SINK_TOKEN.
# @type=boolean
# @sensitive=false
EVENTS_ENABLED=false

# Cloudflare API token with R2 Admin Read & Write, used by the Iceberg sink and catalog maintenance. Read only while deploying, from the process environment, so export it in the deploy shell; never bound into the Worker.
EVENTS_SINK_TOKEN=

# Request analytics visitor ids. "persistent" sets a first-party HttpOnly cookie so one browser keeps one id across visits. "daily" sets no cookie and hashes ip, user agent, and day with a stored salt.
# @type=enum(daily, persistent)
# @sensitive=false
EVENTS_IDENTITY_MODE=persistent

# Workshop agent applications. Nothing sends email unless this is true.
# @type=boolean
# @sensitive=false
INTEREST_SEND_ENABLED=false

# "doi" sends a confirmation email. "capture" records the sign-up with consent evidence and sends nothing. "drovr" forwards it to drovr intake.
# @type=enum(doi, capture, drovr)
# @sensitive=false
INTEREST_MODE=doi

# Drovr intake endpoint and server credential for INTEREST_MODE=drovr. With either missing, delivery fails closed.
# @sensitive=false
DROVR_INTAKE_URL=

# Drovr API base URL for the confirm-page token calls. Missing, every confirm link shows the invalid page.
# @sensitive=false
DROVR_API_BASE=

DROVR_INTAKE_CREDENTIAL=

# HMAC secret that signs the confirmation links. Without it the form routes are off.
INTEREST_TOKEN_SECRET=

# Bearer token for the operator read at GET /operator/interest. Without it the route is off.
INTEREST_OPERATOR_TOKEN=

# PostShiba credentials for the confirmation email.
POSTSHIBA_API_KEY=

# @sensitive=false
POSTSHIBA_TEAM=

# @sensitive=false
POSTSHIBA_CLUSTER=
