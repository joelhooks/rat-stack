{
  "name": "@rat-stack/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#backend": {
      "development": "./src/dev/backend.ts",
      "default": "./src/server/backend.ts"
    },
    "#devtools-overlay": {
      "development": "./src/dev/client/entry.ts",
      "default": "./src/client/no-devtools.ts"
    }
  },
  "scripts": {
    "predev": "pnpm --filter @rat-stack/mischief generate && node --import ../infra/node_modules/alchemy/bin/register-oxc.js scripts/prepare-reader.ts",
    "dev": "portless rat-stack vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node --import ../infra/node_modules/alchemy/bin/register-oxc.js scripts/prepare-reader.ts && vite build && node --import ../infra/node_modules/alchemy/bin/register-oxc.js scripts/finalize-reader.ts",
    "check": "pnpm run typecheck"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@rat-stack/auth": "workspace:*",
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/core": "workspace:*",
    "@rat-stack/devtools": "workspace:*",
    "@rat-stack/json-render-foldkit": "workspace:*",
    "@rat-stack/mischief": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "foldkit": "0.166.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@foldkit/devtools": "0.166.0",
    "@foldkit/vite-plugin": "0.26.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "24.13.6",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.0.7",
    "vitest": "5.0.1"
  }
}
