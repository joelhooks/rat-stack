{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts", "stylex.ts"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedExperimentalApis": [
          "@effect/ui/html/Html#H",
          "@effect/ui/html/Html#component",
          "@effect/ui/html/HtmlHydrate#hydrateEffect",
          "@effect/ui/html/HtmlServer#renderToHtml",
          "@effect/ui/html/HtmlServer#serializeState"
        ],
        "overrides": [
          {
            "include": ["src/client/directory-effect-ui/component.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/Component#noop",
                "@effect/ui/html/Html#component",
                "@effect/ui/html/HtmlCommand#focus"
              ]
            }
          },
          {
            "include": ["src/client/directory-effect-ui/model.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/UiSchema#TaggedEnum",
                "@effect/ui/html/Html#ref"
              ]
            }
          },
          {
            "include": ["test/all-stars-effect-ui.test.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/html/testing#ssr",
                "@effect/ui/testing/TestHost#layer"
              ]
            }
          },
          {
            "include": ["test/directory-effect-ui.test.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/html/HtmlCommand#Focus",
                "@effect/ui/html/HtmlServer#renderToHtml",
                "@effect/ui/html/testing#ssr",
                "@effect/ui/html/testing/HtmlLocator#role",
                "@effect/ui/html/testing/HtmlScene#make",
                "@effect/ui/testing/Story#make",
                "@effect/ui/testing/TestHost#layer",
                "@effect/ui/testing/TestHost#settle"
              ]
            }
          },
          {
            "include": ["src/client/reader-effect-ui/command.ts"],
            "options": {
              "allowedExperimentalApis": ["@effect/ui/Command#make"]
            }
          },
          {
            "include": ["src/client/reader-effect-ui/model.ts"],
            "options": {
              "allowedExperimentalApis": ["@effect/ui/UiSchema#TaggedEnum"]
            }
          },
          {
            "include": ["src/features/reader-effect-ui/view.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/View#Input",
                "@effect/ui/html/Html#H"
              ]
            }
          },
          {
            "include": ["test/reader-effect-ui.test.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/html/HtmlServer#renderToHtml",
                "@effect/ui/html/testing#ssr",
                "@effect/ui/html/testing/HtmlLocator#role",
                "@effect/ui/html/testing/HtmlScene#make",
                "@effect/ui/testing/Story#make",
                "@effect/ui/testing/TestHost#layer"
              ]
            }
          },
          {
            "include": ["test/news-effect-ui.test.ts"],
            "options": {
              "allowedExperimentalApis": [
                "@effect/ui/html/testing#ssr",
                "@effect/ui/html/testing/HtmlLocator#role",
                "@effect/ui/html/testing/HtmlScene#make",
                "@effect/ui/testing/Locator#text",
                "@effect/ui/testing/TestHost#layer"
              ]
            }
          }
        ],
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodePath",
          "@effect/platform-node/NodeServices",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/ai/McpProtocol",
          "effect/ai/McpServer",
          "effect/crypto/Digest",
          "effect/http/FetchHttpClient",
          "effect/http/HttpRouter",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer"
        ]
      }
    ],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vite/client"]
  }
}
