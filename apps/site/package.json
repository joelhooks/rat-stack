{
  "name": "@rat-stack/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./node-content": {
      "types": "./src/node-content.ts",
      "import": "./src/node-content.ts",
      "default": "./src/node-content.ts"
    },
    "./capabilities": {
      "types": "./src/capabilities/index.ts",
      "import": "./src/capabilities/index.ts",
      "default": "./src/capabilities/index.ts"
    },
    "./preview-rpc-worker": {
      "types": "./src/preview-rpc-worker.ts",
      "import": "./src/preview-rpc-worker.ts",
      "default": "./src/preview-rpc-worker.ts"
    },
    "./rpc-worker": {
      "types": "./src/rpc-worker.ts",
      "import": "./src/rpc-worker.ts",
      "default": "./src/rpc-worker.ts"
    },
    "./rat.css": "./src/rat.css",
    "./rat-icons": {
      "types": "./src/rat-icons.ts",
      "import": "./src/rat-icons.ts",
      "default": "./src/rat-icons.ts"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-content.ts",
    "typecheck": "node scripts/prepare-content.ts && effect-tsrs diagnostics --project tsconfig.json --strict --type-check && pnpm run --silent startup:check",
    "typecheck:tsc": "node scripts/prepare-content.ts && tsc --noEmit -p tsconfig.json && pnpm run --silent startup:check",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "startup:check": "node scripts/startup-budget.ts",
    "startup:profile": "pnpm run --silent generate && pnpm run --silent startup:check && wrangler check startup --worker dist/startup/worker.bundle --outfile dist/startup/worker.cpuprofile",
    "test": "vitest run",
    "build": "node scripts/prepare-content.ts && tsc -p tsconfig.build.json",
    "build:check-direct": "node scripts/check-direct-build.ts",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@rat-stack/auth": "workspace:*",
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/core": "workspace:*",
    "@rat-stack/crash": "workspace:*",
    "@rat-stack/database": "workspace:*",
    "@rat-stack/events": "workspace:*",
    "@rat-stack/flags": "workspace:*",
    "@rat-stack/intake-live": "workspace:*",
    "@rat-stack/learn": "workspace:*",
    "@rat-stack/lore": "workspace:*",
    "@rat-stack/subscriber-delivery": "workspace:*",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@effect/platform-browser": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/vitest": "4.0.6",
    "@foldkit/markdown": "0.14.3",
    "@rat-stack/code-snippets": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@types/unist": "3.0.3",
    "foldkit": "0.169.0",
    "htmlparser2": "12.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "satori": "0.33.5",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
