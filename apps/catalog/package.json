{
  "name": "@rat-stack/catalog-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node src/smoke-cli.ts",
    "backfill": "node src/backfill-cli.ts"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@effect/platform-node": "4.1.4",
    "@rat-stack/catalog": "workspace:*",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@alchemy.run/test": "2.0.0-beta.87",
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
