{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "effect/FileSystem"
        ]
      }
    ]
  },
  "include": ["*.config.ts", "scripts/*.ts", "tools/oxlint/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".agent_sources",
    ".agent-sources",
    ".turbo"
  ]
}
