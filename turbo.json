{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "//#lint": {
      "dependsOn": ["@rat-stack/site#generate"],
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": []
    },
    "@rat-stack/site#generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["src/bundled-content.generated.ts"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@rat-stack/site#typecheck": {
      "dependsOn": ["@rat-stack/site#generate", "^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@rat-stack/site#build": {
      "dependsOn": ["@rat-stack/site#generate", "^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@rat-stack/infra#test": {
      "dependsOn": ["^build", "@rat-stack/web#build", "@rat-stack/web#test"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"]
    },
    "@rat-stack/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@rat-stack/site#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@rat-stack/site#check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    }
  }
}
