# Declared environment for this project. Checked in; no values here.
# Declare every variable the app reads. Mark secrets @sensitive. Put local
# values in .env.local (gitignored). Validate with `pnpm env:check`, and run
# commands with injected values via `pnpm exec varlock run -- <cmd>`.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Example non-secret setting. Replace with the project's real variables.
# @type=enum(development, test, production)
# @sensitive=false
APP_ENV=development

# Turbo sets this only inside a task; the content preparation script skips duplicate generation there.
# @type=string
# @sensitive=false
TURBO_HASH=

# Set by portless when `pnpm dev` runs the web app (http://rat-stack.localhost:1355).
# The web dev composition passes it to Better Auth as baseURL.
# @type=url
# @sensitive=false
PORTLESS_URL=

# Agent intake uses its own credential; unset keeps agent signup off.
# @type=string
# @sensitive=true
DROVR_AGENT_INTAKE_CREDENTIAL=

# Optional scorer credential; unset uses code-only abuse scoring.
# @type=string
# @sensitive=true
TYPESAFE_API_KEY=

# Operator-only application reader and intake CLI authorization.
# @type=string
# @sensitive=true
INTEREST_OPERATOR_TOKEN=

# Verified destination for workshop email forwarding, required outside dev.
# @required=forEnv(production)
# @type=string
# @sensitive=true
EMAIL_FORWARD_TO=

# Deployment must select a named Alchemy profile.
# @required=forEnv(production)
# @sensitive=false
ALCHEMY_PROFILE=

# Full checkout commit attached to an isolated PR preview.
# @type=string
# @sensitive=false
PREVIEW_COMMIT=

# Public canonical origin for the isolated reader preview.
# @type=url
# @sensitive=false
PREVIEW_ORIGIN=

# Keep the production analytics footprint explicit.
# @required=forEnv(production)
# @type=boolean
# @sensitive=false
EVENTS_ENABLED=

# @required=forEnv(production)
# @type=enum(daily, persistent)
# @sensitive=false
EVENTS_IDENTITY_MODE=

# @required=forEnv(production)
# @sensitive=true
EVENTS_SINK_TOKEN=

# Content propagation retry budget in milliseconds. The exported driver default is 120000.
# @type=number
# @sensitive=false
DEPLOY_CONTENT_VERSION_DEADLINE_MS=120000

# Live Worker deployment listing can lag a successful full-cutover upload.
# @type=number
# @sensitive=false
DEPLOY_WORKER_VERSION_DEADLINE_MS=120000
