{
  "name": "@rat-stack/auth",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./src/auth-service.ts",
      "import": "./dist/auth-service.js",
      "default": "./dist/auth-service.js"
    },
    "./d1": {
      "types": "./src/d1-auth.ts",
      "import": "./dist/d1-auth.js",
      "default": "./dist/d1-auth.js"
    },
    "./feedback": {
      "types": "./src/feedback.ts",
      "import": "./dist/feedback.js",
      "default": "./dist/feedback.js"
    },
    "./devtools": {
      "types": "./src/devtools.ts",
      "import": "./dist/devtools.js",
      "default": "./dist/devtools.js"
    }
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.83",
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/database": "workspace:*",
    "alchemy": "2.0.0-beta.83",
    "better-auth": "1.7.11",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0",
    "kysely": "0.29.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/vitest": "4.0.0",
    "@rat-stack/devtools": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
