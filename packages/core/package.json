{
  "name": "@rat-stack/core",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./page-catalog": {
      "types": "./src/page-catalog.ts",
      "import": "./dist/page-catalog.js",
      "default": "./dist/page-catalog.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js",
      "default": "./dist/contracts.js"
    },
    "./intake": {
      "types": "./src/intake.ts",
      "import": "./dist/intake.js",
      "default": "./dist/intake.js"
    },
    "./join-interest": {
      "types": "./src/join-interest.ts",
      "import": "./dist/join-interest.js",
      "default": "./dist/join-interest.js"
    },
    "./request-geo": {
      "types": "./src/request-geo.ts",
      "import": "./dist/request-geo.js",
      "default": "./dist/request-geo.js"
    },
    "./interest": {
      "types": "./src/interest.ts",
      "import": "./dist/interest.js",
      "default": "./dist/interest.js"
    }
  },
  "scripts": {
    "typecheck": "node scripts/generate-page-catalog.ts && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node scripts/generate-page-catalog.ts && tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0",
    "@json-render/core": "0.21.0",
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/json-render-foldkit": "workspace:*",
    "@xstate/effect": "0.1.0-alpha.6",
    "effect": "4.0.0",
    "xstate": "6.0.0-alpha.63",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
