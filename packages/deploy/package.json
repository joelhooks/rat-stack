{
  "name": "@rat-stack/deploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.17",
    "@effect/platform-node": "4.0.7",
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/check-harness": "workspace:*",
    "@rat-stack/core": "workspace:*",
    "@xstate/effect": "1.0.0-alpha.10",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.7",
    "xstate": "6.0.0-alpha.71"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/vitest": "4.0.7",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
