{
  "name": "@rat-stack/code-snippets",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fetch": {
      "types": "./src/fetch.ts",
      "import": "./src/fetch.ts",
      "default": "./src/fetch.ts"
    },
    "./git": {
      "types": "./src/git.ts",
      "import": "./src/git.ts",
      "default": "./src/git.ts"
    },
    "./shiki": {
      "types": "./src/shiki.ts",
      "import": "./src/shiki.ts",
      "default": "./src/shiki.ts"
    },
    "./plain": {
      "types": "./src/plain.ts",
      "import": "./src/plain.ts",
      "default": "./src/plain.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "effect": "4.0.0",
    "shiki": "3.23.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
