{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node/NodeServices",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/Crypto",
          "effect/FileSystem",
          "effect/Path"
        ]
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
