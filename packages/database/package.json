{
  "name": "@rat-stack/database",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src",
    "migrations"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./src/d1.ts",
      "import": "./dist/d1.js",
      "default": "./dist/d1.js"
    },
    "./hyperdrive-postgres": {
      "types": "./src/hyperdrive-postgres.ts",
      "import": "./dist/hyperdrive-postgres.js",
      "default": "./dist/hyperdrive-postgres.js"
    }
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/drizzle": "2.0.0-beta.84",
    "@alchemy.run/sql": "2.0.0-beta.84",
    "@effect/sql-pg": "4.0.7",
    "alchemy": "2.0.0-beta.84",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@effect/platform-node": "4.0.7",
    "@effect/vitest": "4.0.7",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sql.js": "1.4.11",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "sql.js": "1.15.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
