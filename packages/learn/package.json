{
  "name": "@rat-stack/learn",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./src/deck-build.ts",
      "import": "./src/deck-build.ts",
      "default": "./src/deck-build.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "dependencies": {
    "@rat-stack/capability": "workspace:*",
    "@rat-stack/core": "workspace:*",
    "@xstate/effect": "0.1.0-alpha.6",
    "effect": "4.0.0",
    "xstate": "6.0.0-alpha.63"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
