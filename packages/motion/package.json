{
  "name": "@rat-stack/motion",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foldkit": {
      "types": "./src/foldkit.ts",
      "import": "./dist/foldkit.js",
      "default": "./dist/foldkit.js"
    }
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "pretest": "pnpm run --silent build"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    }
  }
}
